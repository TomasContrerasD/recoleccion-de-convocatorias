# Copy this file to backend/.env and fill in your own private values.
# PowerShell (from the project root): Copy-Item backend/.env.example backend/.env
# Never commit .env, credential JSON files, passwords, or API keys.
# System environment variables override this file. Restart after editing settings.
# Quote values containing spaces or # characters; passwords are preserved exactly.

# OpenAI: used for classification and JBIC/EDCF translation, not for API startup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Google Sheets: required to save opportunities and check for existing records.
# Create your own spreadsheet, then share it with your service account as editor.
# Paste only the spreadsheet ID from its URL, not the full URL.
SHEETS_CONVOCATORIAS_ID=
SHEETS_TAB_NAME=Convocatorias

# Use your service-account JSON file. Relative paths start at backend/.
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
# Alternative for deployments: supply the service-account JSON through a secret
# environment variable instead of a local file. Leave blank when using a file.
GOOGLE_CREDENTIALS_JSON=

# Optional email summaries: leave these blank to disable notification delivery.
# For Gmail, use your account address and an app password, not its login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=
# The current sender uses implicit TLS (SMTP over SSL).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Optional GCP automation. Manual runs work with this disabled.
# Enabling requires a private random SCHEDULER_SECRET. See docs/gcp.md.
ENABLE_AUTOMATION=false
# The scheduler must send the same value in its X-Scheduler-Secret header.
SCHEDULER_SECRET=

# BEO only: credentials for your own Consulting Firm account at the IDB portal.
# Leave blank if you do not run the BEO source.
BEO_EMAIL=
BEO_PASSWORD=

# Email destination link and permitted browser origins. Use your URLs if deployed.
# Leave PORTAL_URL blank to omit the platform link from emails.
PORTAL_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
