# Copy to frontend/.env.local. These public links contain no credentials.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SHEETS_URL=

# Local npm run dev opens without Google login.
# For npm run build/start or hosting, configure your own Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Production denies sign-in until at least one allowlist is configured.
# Prefer individual addresses for a personal installation.
AUTH_ALLOWED_EMAILS=owner@example.com
AUTH_ALLOWED_DOMAINS=
